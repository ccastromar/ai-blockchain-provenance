PUBLIC_API_URL=http://localhost:3001
PUBLIC_ERNEST_API_KEY=

# --- Enterprise identity via OIDC (ADR-002, Decision A — frontend SSO) ---
# Optional and additive. When PUBLIC_OIDC_ISSUER and PUBLIC_OIDC_CLIENT_ID are set, the
# login page offers "Sign in with SSO" (Authorization Code + PKCE). Register the redirect
# URI <app-origin>/auth/callback in your IdP. The paste-a-key login stays available.
PUBLIC_OIDC_ISSUER=
PUBLIC_OIDC_CLIENT_ID=
# Scopes requested (space-separated).
PUBLIC_OIDC_SCOPE=openid profile email
# Optional. If set, request this API audience and send the access_token to Ernest;
# otherwise the id_token is sent. Must equal the backend's OIDC_AUDIENCE.
PUBLIC_OIDC_AUDIENCE=
# Optional. Skip discovery by pinning the IdP endpoints directly.
PUBLIC_OIDC_AUTH_ENDPOINT=
PUBLIC_OIDC_TOKEN_ENDPOINT=
