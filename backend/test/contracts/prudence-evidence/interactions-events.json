{
  "version": "prudence.ernest-evidence/v1",
  "provider": "Ernest",
  "consumer": "Prudence",
  "mode": "EVIDENCE_BATCHING=events",
  "description": "The conversation with an Ernest in its default mode (EVIDENCE_BATCHING=events): every record goes through the event store, so retries are duplicates and conflicting re-sends are refused, and each event is chained in its own block before the write answers (README.md).",
  "interactions": [
    {
      "id": "register-reviews",
      "consumer": "ReviewSealAdapter",
      "request": {
        "method": "POST",
        "path": "/api/models",
        "body": {
          "modelId": "prudence-reviews",
          "modelName": "Prudence governance reviews",
          "version": "1",
          "mlflow": {
            "gitCommit": "0000000",
            "modelHash": "9426804aabd0aee7173535d495ac68325c7f65fb3159480068535abfeb3eaa87"
          },
          "metadata": {
            "kind": "governance-register",
            "systemOfRecord": "prudence"
          }
        }
      },
      "response": {
        "status": 201
      }
    },
    {
      "id": "seal-review",
      "consumer": "ReviewSealAdapter",
      "request": {
        "method": "POST",
        "path": "/api/inferences",
        "body": {
          "modelId": "prudence-reviews",
          "inferenceId": "rev-1",
          "inputHash": "84fcf9beaab5496cf068f74692ca09223f76021a80e0da1292b9a798de21e727",
          "outputHash": "84fcf9beaab5496cf068f74692ca09223f76021a80e0da1292b9a798de21e727",
          "metadata": {
            "aiSystemId": "sys-credit",
            "action": "APPROVE",
            "reviewerPseudonym": "82fb758793cf309500eb75e287f2354b75b5098967b1132b1349a3600ccffb15",
            "reason": null,
            "at": "2026-10-26T08:00:00Z",
            "previousStatus": "PENDING_REVIEW",
            "newStatus": "APPROVED",
            "stage": "governance_review",
            "reviewId": "rev-1"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "blockIndex": 2,
          "duplicate": false
        },
        "equal": [
          "duplicate"
        ]
      }
    },
    {
      "id": "seal-review-again",
      "consumer": "ReviewSealAdapter",
      "request": {
        "method": "POST",
        "path": "/api/inferences",
        "body": {
          "modelId": "prudence-reviews",
          "inferenceId": "rev-1",
          "inputHash": "84fcf9beaab5496cf068f74692ca09223f76021a80e0da1292b9a798de21e727",
          "outputHash": "84fcf9beaab5496cf068f74692ca09223f76021a80e0da1292b9a798de21e727",
          "metadata": {
            "aiSystemId": "sys-credit",
            "action": "APPROVE",
            "reviewerPseudonym": "82fb758793cf309500eb75e287f2354b75b5098967b1132b1349a3600ccffb15",
            "reason": null,
            "at": "2026-10-26T08:00:00Z",
            "previousStatus": "PENDING_REVIEW",
            "newStatus": "APPROVED",
            "stage": "governance_review",
            "reviewId": "rev-1"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "blockIndex": 2,
          "duplicate": true
        },
        "equal": [
          "blockIndex",
          "duplicate"
        ]
      }
    },
    {
      "id": "seal-review-conflict",
      "consumer": "ReviewSealAdapter",
      "request": {
        "method": "POST",
        "path": "/api/inferences",
        "body": {
          "modelId": "prudence-reviews",
          "inferenceId": "rev-1",
          "inputHash": "4972aa82aab3832b2994a14f559b0ffd18ba2c7e34d46a93a6aed71aabc65d8c",
          "outputHash": "4972aa82aab3832b2994a14f559b0ffd18ba2c7e34d46a93a6aed71aabc65d8c",
          "metadata": {
            "aiSystemId": "sys-credit",
            "action": "APPROVE",
            "reviewerPseudonym": "82fb758793cf309500eb75e287f2354b75b5098967b1132b1349a3600ccffb15",
            "reason": "changed",
            "at": "2026-10-26T08:00:00Z",
            "previousStatus": "PENDING_REVIEW",
            "newStatus": "APPROVED",
            "stage": "governance_review",
            "reviewId": "rev-1"
          }
        }
      },
      "response": {
        "status": 409,
        "contains": "already recorded with different content"
      }
    },
    {
      "id": "register-reviews-again",
      "consumer": "ReviewSealAdapter",
      "request": {
        "method": "POST",
        "path": "/api/models",
        "body": {
          "modelId": "prudence-reviews",
          "modelName": "Prudence governance reviews",
          "version": "1",
          "mlflow": {
            "gitCommit": "0000000",
            "modelHash": "9426804aabd0aee7173535d495ac68325c7f65fb3159480068535abfeb3eaa87"
          },
          "metadata": {
            "kind": "governance-register",
            "systemOfRecord": "prudence"
          }
        }
      },
      "response": {
        "status": 400,
        "contains": "already exists"
      }
    },
    {
      "id": "seal-second-review",
      "consumer": "ReviewSealAdapter",
      "request": {
        "method": "POST",
        "path": "/api/inferences",
        "body": {
          "modelId": "prudence-reviews",
          "inferenceId": "rev-2",
          "inputHash": "84fcf9beaab5496cf068f74692ca09223f76021a80e0da1292b9a798de21e727",
          "outputHash": "84fcf9beaab5496cf068f74692ca09223f76021a80e0da1292b9a798de21e727",
          "metadata": {
            "aiSystemId": "sys-credit",
            "action": "APPROVE",
            "reviewerPseudonym": "82fb758793cf309500eb75e287f2354b75b5098967b1132b1349a3600ccffb15",
            "reason": null,
            "at": "2026-10-26T08:00:00Z",
            "previousStatus": "PENDING_REVIEW",
            "newStatus": "APPROVED",
            "stage": "governance_review",
            "reviewId": "rev-2"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "blockIndex": 3
        }
      }
    },
    {
      "id": "register-decision-system",
      "consumer": "ErnestEvidenceAdapter",
      "request": {
        "method": "POST",
        "path": "/api/models",
        "body": {
          "modelId": "sys-credit",
          "modelName": "AI system sys-credit",
          "version": "1",
          "mlflow": {
            "gitCommit": "0000000",
            "modelHash": "67bdae1953aaddba85049e9926e8072b446162310afedb38e707d54c7b91d8f3"
          },
          "metadata": {
            "source": "prudence-pdp",
            "aiSystemId": "sys-credit"
          }
        }
      },
      "response": {
        "status": 201
      }
    },
    {
      "id": "decisions-batch",
      "consumer": "ErnestEvidenceAdapter",
      "request": {
        "method": "POST",
        "path": "/api/inferences/batch",
        "body": {
          "items": [
            {
              "modelId": "sys-credit",
              "inferenceId": "dec-1",
              "inputHash": "1494169a0e62748fb53b88e702e21d3b211f5f3e2b8f93853a9281b4f0ef9759",
              "outputHash": "24096ec1ad6e916f786bf1c886dcd9ebb54987dfb9c80bcb9a8e608401b0a64f",
              "metadata": {
                "stage": "governance_decision",
                "subject": "aos",
                "pipeline": "credit_prescreening",
                "action": "run",
                "aiSystemId": "sys-credit",
                "policyVersion": "lab",
                "policyHash": "sha256:policy",
                "systemVersion": "1.0.0",
                "modelHash": "sha256:model",
                "decision": "ALLOW"
              }
            },
            {
              "modelId": "sys-credit",
              "inferenceId": "dec-2",
              "inputHash": "1494169a0e62748fb53b88e702e21d3b211f5f3e2b8f93853a9281b4f0ef9759",
              "outputHash": "ca1d2c4dc14349a299445e4b12193ecedecc922d80b93394a7a21d817a016156",
              "metadata": {
                "stage": "governance_decision",
                "subject": "aos",
                "pipeline": "credit_prescreening",
                "action": "run",
                "aiSystemId": "sys-credit",
                "policyVersion": "lab",
                "policyHash": "sha256:policy",
                "systemVersion": "1.0.0",
                "modelHash": "sha256:model",
                "decision": "DENY",
                "reason": "prohibited AI system"
              }
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "body": {
          "results": [
            {
              "status": 200
            },
            {
              "status": 200
            }
          ]
        },
        "oneOf": {
          "results[].status": [
            200
          ]
        }
      }
    },
    {
      "id": "register-attestations",
      "consumer": "ErnestAttestationAdapter",
      "request": {
        "method": "POST",
        "path": "/api/models",
        "body": {
          "modelId": "prudence-attestations",
          "modelName": "Prudence attestations",
          "version": "1",
          "mlflow": {
            "gitCommit": "0000000",
            "modelHash": "f7b822fff133410f33933640342b65e40b30fb408590e8c1800fc7d0eb7190a5"
          },
          "metadata": {
            "kind": "governance-register",
            "systemOfRecord": "prudence"
          }
        }
      },
      "response": {
        "status": 201
      }
    },
    {
      "id": "seal-attestation",
      "consumer": "ErnestAttestationAdapter",
      "request": {
        "method": "POST",
        "path": "/api/inferences",
        "body": {
          "modelId": "prudence-attestations",
          "inferenceId": "att-1",
          "inputHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "outputHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "metadata": {
            "overallPosture": "GREEN",
            "stage": "attestation",
            "attestationId": "att-1"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "blockIndex": 8
        }
      }
    },
    {
      "id": "attestation-proof",
      "consumer": "ErnestAttestationAdapter",
      "request": {
        "method": "GET",
        "path": "/api/events/api%2Fprudence-attestations/att-1/proof"
      },
      "response": {
        "status": 200,
        "body": {
          "status": "chained",
          "event": {
            "source": "api/prudence-attestations",
            "eventId": "att-1",
            "seq": 8,
            "data": {
              "type": "inference",
              "modelId": "prudence-attestations",
              "inferenceId": "att-1",
              "inputHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "outputHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "metadata": {
                "overallPosture": "GREEN",
                "stage": "attestation",
                "attestationId": "att-1"
              },
              "executedAt": "2026-10-26T09:07:04.347Z"
            },
            "leafHash": "a889e785fd6d6719dc51131c0d329014fd66e85e6b3aaf7cd2031c75011e8d20"
          },
          "inclusion": {
            "kind": "block"
          },
          "block": {
            "index": 8,
            "timestamp": 1793005624,
            "data": {
              "type": "inference",
              "modelId": "prudence-attestations",
              "inferenceId": "att-1",
              "inputHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "outputHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "metadata": {
                "overallPosture": "GREEN",
                "stage": "attestation",
                "attestationId": "att-1"
              },
              "executedAt": "2026-10-26T09:07:04.347Z"
            },
            "previousHash": "385c6ed70452d2a43f4cd9b55d21a79a50cf6fdf4fa24d98766a0aa6eefdcb62",
            "hash": "941bf1b05ac884b026573d84fe0f2573a334b9a8048bdbf5f78c420581945480"
          }
        },
        "equal": [
          "status"
        ]
      },
      "note": "A real proof from Ernest v0.3 with EVIDENCE_BATCHING=events: one block per event (inclusion kind `block`), which Prudence verifies by recomputing the block hash and comparing the event's data with the block's."
    },
    {
      "id": "verify-for-attestation",
      "consumer": "ErnestAttestationAdapter",
      "request": {
        "method": "GET",
        "path": "/api/verify"
      },
      "response": {
        "status": 200,
        "body": {
          "isValid": true
        },
        "equal": [
          "isValid"
        ]
      }
    },
    {
      "id": "runtime-execution",
      "consumer": null,
      "request": {
        "method": "POST",
        "path": "/api/inferences",
        "body": {
          "modelId": "sys-credit",
          "inferenceId": "exec-1",
          "inputHash": "44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a",
          "outputHash": "1e5d2c8f7e8a5b1b3c3f1c7d6e2a9b8c4d5e6f708192a3b4c5d6e7f8091a2b3c",
          "metadata": {
            "stage": "execution",
            "aiSystemId": "sys-credit",
            "pipeline": "credit_prescreening",
            "runtime": "langgraph",
            "decisionId": "dec-1"
          }
        }
      },
      "response": {
        "status": 200
      },
      "note": "Written by a runtime (prudence-core log_execution, AOS), not by Prudence: it gives the execution counts something to count."
    },
    {
      "id": "verify-for-posture",
      "consumer": "ErnestEvidenceHealthAdapter",
      "request": {
        "method": "GET",
        "path": "/api/verify"
      },
      "response": {
        "status": 200,
        "body": {
          "isValid": true,
          "chainLength": 10
        },
        "equal": [
          "isValid"
        ]
      }
    },
    {
      "id": "evidence-counts",
      "consumer": "ErnestEvidenceHealthAdapter",
      "request": {
        "method": "GET",
        "path": "/api/stats/models?ids=sys-credit,sys-unused"
      },
      "response": {
        "status": 200,
        "body": {
          "counts": {
            "sys-credit": 4
          }
        },
        "eventually": true
      }
    },
    {
      "id": "system-integrity",
      "consumer": "ErnestEvidenceHealthAdapter",
      "request": {
        "method": "GET",
        "path": "/api/models/sys-credit/integrity"
      },
      "response": {
        "status": 200,
        "body": {
          "isValid": true,
          "totalBlocks": 4
        },
        "equal": [
          "isValid"
        ],
        "eventually": true
      }
    },
    {
      "id": "execution-counts",
      "consumer": "ErnestEvidenceHealthAdapter",
      "request": {
        "method": "GET",
        "path": "/api/stats/executions"
      },
      "response": {
        "status": 200,
        "body": {
          "counts": {
            "sys-credit": 1
          },
          "lastExecutionAt": {
            "sys-credit": "2026-10-26T08:00:00.000Z"
          }
        },
        "equal": [
          "counts"
        ],
        "eventually": true
      }
    }
  ]
}
