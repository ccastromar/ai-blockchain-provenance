PORT=3001
MONGODB_URI=mongodb://localhost:27017/ernest
CORS_ORIGIN=http://localhost:3000

# Optional. If either this or ERNEST_READ_API_KEY is set, every route except /health and
# /api/auth/whoami requires the X-Ernest-Api-Key header. Write endpoints (POST/PATCH,
# e.g. /api/models, /api/inferences, /api/anchors) additionally require this specific
# key -- ERNEST_READ_API_KEY alone cannot write.
ERNEST_API_KEY=

# Optional. Grants read-only (GET-only) access without the write key above. Hand this
# to auditors/reviewers instead of ERNEST_API_KEY.
ERNEST_READ_API_KEY=

# --- Enterprise identity via OIDC (ADR-002, Decision A) ---
# Optional and additive: enabled only when both OIDC_ISSUER and OIDC_AUDIENCE are set.
# When enabled, callers may authenticate with `Authorization: Bearer <JWT>` from your IdP;
# the static API keys and Mongo tokens above keep working (CI, scripts, air-gap). A bearer
# that maps to a usable role wins; otherwise auth falls through to the keys.
OIDC_ISSUER=
# The API's expected audience (aud claim) -- your app/client or resource identifier.
OIDC_AUDIENCE=
# Optional. Skip OIDC discovery and use this JWKS endpoint directly.
OIDC_JWKS_URI=
# Claim holding the caller's groups/roles (string, space-delimited string, or array).
OIDC_ROLE_CLAIM=roles
# Map IdP groups to Ernest roles. read-write wins over read-only when both match.
OIDC_ROLE_MAP=ernest-writers=read-write,ernest-auditors=read-only
# Role for a valid token whose groups match nothing above. Default: anonymous (no access).
# Set to read-only to let any authenticated caller read.
OIDC_DEFAULT_ROLE=anonymous
# Allowed clock skew (seconds) when validating exp/nbf/iat.
OIDC_CLOCK_TOLERANCE_SECONDS=30

# ADR-001 signed submissions: off = ignore envelopes, optional (default) = verify
# when present, required = reject unsigned writes. Emitter public keys are
# registered via POST /api/auth/emitters; generate a keypair with `ernest emitter
# keygen` and sign with integrations/signing/sign-submission.mjs.
SIGNED_SUBMISSIONS=optional

# Optional event ingestion proxy. If EVENT_INGESTOR_API_KEY is set, the backend injects it
# server-side when calling the Go ingestor; do not expose it in frontend env.
EVENT_INGESTOR_URL=http://localhost:3011
EVENT_INGESTOR_API_KEY=
HF_WEBHOOK_SECRET=
EVENT_PROVIDER_HMAC_SECRET=

# Optional. Required only for local/Sepolia anchoring and /api/events queries.
# For local Hardhat demos, use the repository-level .env.local-chain.example.
INFURA_URL=
PRIVATE_KEY=
CONTRACT_ADDRESS=
ANCHOR_ORGANIZATION_ID=ernest-demo
ANCHOR_ORGANIZATION_NAME=Ernest Demo
ANCHOR_DOMAIN=ai-provenance
ANCHOR_EVERY_N_BLOCKS=50

# ADR-004 Merkle-batched evidence. off (default) = one block per event, appended
# synchronously. events = rollout step 1: idempotent event store, still one block per event
# (same chain shape; responses wait for the block). on = one batch block per interval with an
# RFC 6962 root; submissions answer 202 pending unless ?wait=true. Not production-ready until
# reads and verifiers follow (see docs/adr-004-merkle-batched-evidence.md).
EVIDENCE_BATCHING=off
BATCH_INTERVAL_MS=1000
BATCH_MAX_EVENTS=1000

# Process roles (CQRS split; docs/adr-004-merkle-batched-evidence.md "Deployment roles").
# Comma list of reader | writer | chainer, or all (default = today's single process).
# reader = read API only (405 on writes, no jobs) and scales out; writer = submissions;
# chainer = the only chain writer (batcher, anchoring, integrity check). A writer without
# chainer refuses to start unless EVIDENCE_BATCHING is events or on.
ERNEST_ROLE=all

# ADR-006 chain indexer (runs with the chainer role): validates each block when connected and
# keeps the read models (per-model counts, per-system executions) that stats and per-model
# integrity are answered from. Reads fall back to the store when the index lags more than
# CHAIN_INDEXER_MAX_LAG_BLOCKS behind the tip. Drop chain_index_state/model_index/system_index
# to rebuild from block 0.
CHAIN_INDEXER=on
CHAIN_INDEXER_INTERVAL_MS=1000
CHAIN_INDEXER_MAX_LAG_BLOCKS=100

# Anchoring provider: 'ots' (OpenTimestamps on Bitcoin — free, keyless, no crypto
# custody; proofs complete after calendar aggregation, typically hours) or leave
# unset for contract anchoring when INFURA_URL/PRIVATE_KEY/CONTRACT_ADDRESS are set.
ANCHOR_PROVIDER=

# Optional. If set, receives a POST when an anchor confirms or when the hourly
# chain-integrity check (see health.controller.ts) finds the hashchain broken.
WEBHOOK_URL=

# Hours between FULL integrity re-scans (hourly checks in between are incremental
# from the last checkpoint; only a full scan re-reads pre-checkpoint block data).
INTEGRITY_FULL_SCAN_HOURS=24

# Optional, opt-in. If set (e.g. pool.ntp.org), the hourly integrity check also
# measures local clock drift via SNTP and alerts WEBHOOK_URL (event
# clock.drift.exceeded) when |offset| > NTP_MAX_DRIFT_MS. Drift does not invalidate
# the chain; block timestamps are claims and this detects when the claiming clock
# is skewed (threat model N3). Network failures are soft.
NTP_CHECK_SERVER=
NTP_MAX_DRIFT_MS=5000

# --- Qualified electronic timestamp via RFC 3161 (ADR-002, Decision B1) ---
# Optional and additive: when enabled, each anchor also gets an RFC 3161 timestamp over
# the same Merkle root, requested ALONGSIDE (never instead of) OTS/EVM. Fail-soft: a TSA
# outage never blocks an anchor (it alerts WEBHOOK_URL with qts.timestamp.failed).
# Point QTS_TSA_URL at a QUALIFIED TSA operated by an EU QTSP for eIDAS legal presumption;
# any RFC 3161 TSA gives the same cryptographic proof without the qualification.
# Verify a token offline: openssl ts -verify -data ernest-anchor-<id> \
#   -in ernest-anchor-<id>.tsr -CAfile <tsa-chain>.pem
ANCHOR_QTS_ENABLED=false
QTS_TSA_URL=
# Optional HTTP basic auth for the TSA, as "user:pass".
QTS_TSA_AUTH=

# --- Qualified electronic seal for emitter signatures (ADR-002, Decision B2 — scaffolding) ---
# SEAL_LEVEL selects how authorship trust is established for signed submissions:
#   self (default) = per-emitter Ed25519 admitted against Ernest's key registry (ADR-001);
#   qualified      = require an eIDAS qualified electronic seal (alg qeseal-*) whose X.509
#                    chain validates to a trust anchor below. Trust derives from the QTSP.
SEAL_LEVEL=self
# PEM bundle of trust anchors for qualified-seal chain validation. Supply manually for now;
# the remaining production step is to source/refresh it from the EU List of Trusted Lists
# (LOTL) so a validated chain means "qualified under eIDAS".
QSEAL_TRUSTED_CA_PEM=

# --- Data lifecycle (ADR-003): retention floor ---
# Minimum days history is kept before it is even eligible to archive/prune (AI Act Art.
# 19/26 require >= 6 months). Legal holds exempt matching blocks regardless of age.
# Destructive pruning is NOT enabled yet (it needs the integrity re-scan to respect a
# prune watermark); the lifecycle endpoints plan and archive only.
RETENTION_MIN_DAYS=180
