PORT=3001
MONGODB_URI=mongodb://localhost:27017/ernest
CORS_ORIGIN=http://localhost:3000

# Optional. If either this or ERNEST_READ_API_KEY is set, every route except /health and
# /api/auth/whoami requires the X-Ernest-Api-Key header. Write endpoints (POST/PATCH,
# e.g. /api/models, /api/inferences, /api/anchors) additionally require this specific
# key -- ERNEST_READ_API_KEY alone cannot write.
ERNEST_API_KEY=

# Optional. Grants read-only (GET-only) access without the write key above. Hand this
# to auditors/reviewers instead of ERNEST_API_KEY.
ERNEST_READ_API_KEY=

# Optional event ingestion proxy. If EVENT_INGESTOR_API_KEY is set, the backend injects it
# server-side when calling the Go ingestor; do not expose it in frontend env.
EVENT_INGESTOR_URL=http://localhost:3011
EVENT_INGESTOR_API_KEY=
HF_WEBHOOK_SECRET=
EVENT_PROVIDER_HMAC_SECRET=

# Optional. Required only for local/Sepolia anchoring and /api/events queries.
# For local Hardhat demos, use the repository-level .env.local-chain.example.
INFURA_URL=
PRIVATE_KEY=
CONTRACT_ADDRESS=
ANCHOR_ORGANIZATION_ID=ernest-demo
ANCHOR_ORGANIZATION_NAME=Ernest Demo
ANCHOR_DOMAIN=ai-provenance
ANCHOR_EVERY_N_BLOCKS=50

# Anchoring provider: 'ots' (OpenTimestamps on Bitcoin — free, keyless, no crypto
# custody; proofs complete after calendar aggregation, typically hours) or leave
# unset for contract anchoring when INFURA_URL/PRIVATE_KEY/CONTRACT_ADDRESS are set.
ANCHOR_PROVIDER=

# Optional. If set, receives a POST when an anchor confirms or when the hourly
# chain-integrity check (see health.controller.ts) finds the hashchain broken.
WEBHOOK_URL=

# Hours between FULL integrity re-scans (hourly checks in between are incremental
# from the last checkpoint; only a full scan re-reads pre-checkpoint block data).
INTEGRITY_FULL_SCAN_HOURS=24

# Optional, opt-in. If set (e.g. pool.ntp.org), the hourly integrity check also
# measures local clock drift via SNTP and alerts WEBHOOK_URL (event
# clock.drift.exceeded) when |offset| > NTP_MAX_DRIFT_MS. Drift does not invalidate
# the chain; block timestamps are claims and this detects when the claiming clock
# is skewed (threat model N3). Network failures are soft.
NTP_CHECK_SERVER=
NTP_MAX_DRIFT_MS=5000
