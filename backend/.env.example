PORT=3001
MONGODB_URI=mongodb://localhost:27017/ernest
CORS_ORIGIN=http://localhost:3000

# Optional. If set, POST /api/models, /api/inferences and /api/anchors require this header:
# X-Ernest-Api-Key: <value>
ERNEST_API_KEY=

# Optional event ingestion proxy. If EVENT_INGESTOR_API_KEY is set, the backend injects it
# server-side when calling the Go ingestor; do not expose it in frontend env.
EVENT_INGESTOR_URL=http://localhost:3011
EVENT_INGESTOR_API_KEY=
HF_WEBHOOK_SECRET=

# Optional. Required only for local/Sepolia anchoring and /api/events queries.
# For local Hardhat demos, use the repository-level .env.local-chain.example.
INFURA_URL=
PRIVATE_KEY=
CONTRACT_ADDRESS=
ANCHOR_ORGANIZATION_ID=ernest-demo
ANCHOR_ORGANIZATION_NAME=Ernest Demo
ANCHOR_DOMAIN=ai-provenance
ANCHOR_EVERY_N_BLOCKS=50
