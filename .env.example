# Ernest local stack
MONGODB_URI=mongodb://mongodb:27017/ernest
PORT=3001
PUBLIC_API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# Optional. If either this or ERNEST_READ_API_KEY is set, every route except /health
# and /api/auth/whoami requires a matching X-Ernest-Api-Key. Write endpoints
# (POST/PATCH) additionally require this specific key -- ERNEST_READ_API_KEY alone
# cannot write.
ERNEST_API_KEY=

# Optional. Grants read-only access (GET routes only) without granting the write key
# above. Give this one to auditors / reviewers instead of the read-write key.
ERNEST_READ_API_KEY=

# ADR-001 signed submissions: off = ignore envelopes, optional (default) = verify
# when present, required = reject unsigned writes. Emitter public keys are
# registered via POST /api/auth/emitters; generate a keypair with `ernest emitter
# keygen` and sign with integrations/signing/sign-submission.mjs.
SIGNED_SUBMISSIONS=optional

# Optional browser-demo key. This is public in the built frontend; do not use it as a production secret.
# A user can still override it at runtime from the UI (stored in sessionStorage only).
PUBLIC_ERNEST_API_KEY=

# Optional event ingestion layer. If EVENT_INGESTOR_API_KEY is set, ingestor write endpoints require:
# X-Ernest-Ingest-Key: <value>
EVENT_INGESTOR_API_KEY=
EVENT_INGESTOR_URL=http://event-ingestor:3011
HF_WEBHOOK_SECRET=
EVENT_PROVIDER_HMAC_SECRET=

# Requests signed with EVENT_PROVIDER_HMAC_SECRET must include a fresh
# X-Ernest-Provider-Timestamp within this many seconds of "now", or verification fails
# even if the signature is otherwise correct (replay protection).
PROVIDER_HMAC_TOLERANCE_SECONDS=300

REDIS_STREAM=ernest:events:incoming
REDIS_STREAM_MAXLEN=10000
REDIS_DLQ_STREAM=ernest:events:deadletter
REDIS_REJECTED_STREAM=ernest:events:rejected
REDIS_GROUP=provenance-writers
REDIS_CONSUMER=event-writer-1
WORKER_BATCH_COUNT=10
WORKER_BLOCK_MS=5000
MAX_PAYLOAD_BYTES=1048576

# Per-source-IP rate limiting on the ingestor's HTTP receiver. RATE_LIMIT_RPS<=0 disables it.
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# Prometheus /metrics port, exposed separately from the public ingest port on both
# event-ingestor and event-writer.
METRICS_PORT=9102

# Optional prebuilt image deployment
ERNEST_IMAGE_NAMESPACE=ghcr.io/ccastromar
ERNEST_IMAGE_TAG=latest

# Optional EVM anchoring and event queries.
# For local Hardhat demos, copy .env.local-chain.example to .env.local-chain
# and use docker-compose.local-chain.yml.
INFURA_URL=
PRIVATE_KEY=
CONTRACT_ADDRESS=
ANCHOR_ORGANIZATION_ID=ernest-demo
ANCHOR_ORGANIZATION_NAME=Ernest Demo
ANCHOR_DOMAIN=ai-provenance
ANCHOR_EVERY_N_BLOCKS=50

# Anchoring provider: 'ots' (OpenTimestamps on Bitcoin — free, keyless, no crypto
# custody; proofs complete after calendar aggregation, typically hours) or leave
# unset for contract anchoring when INFURA_URL/PRIVATE_KEY/CONTRACT_ADDRESS are set.
ANCHOR_PROVIDER=

# Optional. If set, receives a POST when an anchor confirms or when the hourly
# chain-integrity check finds the hashchain broken.
WEBHOOK_URL=

# Hours between FULL integrity re-scans (hourly checks in between are incremental
# from the last checkpoint; only a full scan re-reads pre-checkpoint block data).
INTEGRITY_FULL_SCAN_HOURS=24

# Optional, opt-in. If set (e.g. pool.ntp.org), the hourly integrity check also
# measures local clock drift via SNTP and alerts WEBHOOK_URL (event
# clock.drift.exceeded) when |offset| > NTP_MAX_DRIFT_MS. Drift does not invalidate
# the chain; block timestamps are claims and this detects when the claiming clock
# is skewed (threat model N3). Network failures are soft.
NTP_CHECK_SERVER=
NTP_MAX_DRIFT_MS=5000

# Optional auditor agent
ERNEST_URL=http://backend:3001
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=not-needed
OPENAI_MODEL=qwen3:8b
